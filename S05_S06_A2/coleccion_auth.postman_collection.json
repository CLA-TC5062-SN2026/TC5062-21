{
  "info": {
    "name": "S05-S06-A2-Autenticacion",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000/api"
    },
    {
      "key": "runId",
      "value": "{{$timestamp}}"
    }
  ],
  "item": [
    {
      "name": "01 Registro Consulta",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/auth/register",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"correo\": \"registro{{runId}}@equipo21.test\",\n  \"nombre\": \"Registro ficticio\",\n  \"contrasena\": \"{{demoPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"Respuesta JSON\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"));",
              "pm.test(\"Sin secretos de almacenamiento\", () => { const text = pm.response.text(); pm.expect(text).not.to.include(\"hashContrasena\"); pm.expect(text).not.to.include(\"hash_contrasena\"); });",
              "pm.test(\"Sin contraseña\", () => { pm.expect(pm.response.json()).not.to.have.property(\"contrasena\"); pm.expect(pm.response.json().rol).to.eql(\"Consulta\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Login Administrador ficticio",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/auth/login",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"correo\": \"{{adminEmail}}\",\n  \"contrasena\": \"{{demoPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Respuesta JSON\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"));",
              "pm.test(\"Sin secretos de almacenamiento\", () => { const text = pm.response.text(); pm.expect(text).not.to.include(\"hashContrasena\"); pm.expect(text).not.to.include(\"hash_contrasena\"); });",
              "pm.test(\"JWT presente\", () => pm.expect(pm.response.json().accessToken.split(\".\")).to.have.lengthOf(3)); pm.collectionVariables.set(\"adminToken\",pm.response.json().accessToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Perfil del token anterior",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/auth/me",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Respuesta JSON\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"));",
              "pm.test(\"Sin secretos de almacenamiento\", () => { const text = pm.response.text(); pm.expect(text).not.to.include(\"hashContrasena\"); pm.expect(text).not.to.include(\"hash_contrasena\"); });",
              "pm.test(\"Identidad y rol\", () => { pm.expect(pm.response.json().correo).to.eql(pm.variables.get(\"adminEmail\")); pm.expect(pm.response.json().rol).to.eql(\"Administrador\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "04 CRUD con token y rol correctos",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/v1/capas",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Capa autenticada {{runId}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"Respuesta JSON\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"));",
              "pm.test(\"Sin secretos de almacenamiento\", () => { const text = pm.response.text(); pm.expect(text).not.to.include(\"hashContrasena\"); pm.expect(text).not.to.include(\"hash_contrasena\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Misma ruta sin token",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/v1/capas",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Rechazo sin token\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));",
              "pm.test(\"Respuesta JSON\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"));",
              "pm.test(\"Sin secretos de almacenamiento\", () => { const text = pm.response.text(); pm.expect(text).not.to.include(\"hashContrasena\"); pm.expect(text).not.to.include(\"hash_contrasena\"); });",
              "pm.test(\"Desafío Bearer\", () => pm.expect(pm.response.headers.get(\"WWW-Authenticate\")).to.eql(\"Bearer\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "06 Misma ruta con rol incorrecto",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/v1/capas",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{consultaToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Rechazo por rol\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 403\", () => pm.response.to.have.status(403));",
              "pm.test(\"Respuesta JSON\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"));",
              "pm.test(\"Sin secretos de almacenamiento\", () => { const text = pm.response.text(); pm.expect(text).not.to.include(\"hashContrasena\"); pm.expect(text).not.to.include(\"hash_contrasena\"); });"
            ]
          }
        }
      ]
    }
  ]
}
