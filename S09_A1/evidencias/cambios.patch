+def test_query_budgets_do_not_return_to_full_scan(api):
+    sample = run_sample(api.test_engine, 60)
+    assert sample["listar_pagina_1"] <= 55
+    assert sample["guardar_8_campos"] <= 2
+    assert sample["modificar_nombre"] <= 30
