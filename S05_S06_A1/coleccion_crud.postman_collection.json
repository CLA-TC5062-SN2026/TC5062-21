{
  "info": {
    "name": "S05-S06-A1-CRUD",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8001/api"
    },
    {
      "key": "runId",
      "value": "{{$timestamp}}"
    }
  ],
  "item": [
    {
      "name": "01 Crear capa",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/v1/capas",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Capa Postman {{runId}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"Respuesta JSON\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"));",
              "pm.test(\"Sin secretos de almacenamiento\", () => { const text = pm.response.text(); pm.expect(text).not.to.include(\"hashContrasena\"); pm.expect(text).not.to.include(\"hash_contrasena\"); });",
              "pm.collectionVariables.set(\"capaId\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Recuperar capa persistida",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/v1/capas/{{capaId}}",
        "header": [],
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Respuesta JSON\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"));",
              "pm.test(\"Sin secretos de almacenamiento\", () => { const text = pm.response.text(); pm.expect(text).not.to.include(\"hashContrasena\"); pm.expect(text).not.to.include(\"hash_contrasena\"); });",
              "pm.test(\"Persistencia de capa\", () => pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get(\"capaId\")));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Crear tipo con campo Nombre",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/v1/tipos-elemento",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Proyecto de video\",\n  \"capaId\": \"{{capaId}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"Respuesta JSON\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"));",
              "pm.test(\"Sin secretos de almacenamiento\", () => { const text = pm.response.text(); pm.expect(text).not.to.include(\"hashContrasena\"); pm.expect(text).not.to.include(\"hash_contrasena\"); });",
              "const t = pm.response.json(); pm.collectionVariables.set(\"tipoId\",t.id); pm.collectionVariables.set(\"campoNombreId\",t.campos.find(c => c.esBaseNombre).id);"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Crear elemento",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/v1/elementos",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tipoElementoId\": \"{{tipoId}}\",\n  \"valores\": [\n    {\n      \"campoId\": \"{{campoNombreId}}\",\n      \"texto\": \"Proyecto ficticio\"\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"Respuesta JSON\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"));",
              "pm.test(\"Sin secretos de almacenamiento\", () => { const text = pm.response.text(); pm.expect(text).not.to.include(\"hashContrasena\"); pm.expect(text).not.to.include(\"hash_contrasena\"); });",
              "pm.collectionVariables.set(\"elementoId\",pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Recuperar elemento persistido",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/v1/elementos/{{elementoId}}",
        "header": [],
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Respuesta JSON\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"));",
              "pm.test(\"Sin secretos de almacenamiento\", () => { const text = pm.response.text(); pm.expect(text).not.to.include(\"hashContrasena\"); pm.expect(text).not.to.include(\"hash_contrasena\"); });",
              "pm.test(\"Persistencia de valores\", () => pm.expect(pm.response.json().nombre).to.eql(\"Proyecto ficticio\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "06 Baja lógica del elemento",
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/v1/elementos/{{elementoId}}",
        "header": [],
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Respuesta JSON\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"));",
              "pm.test(\"Sin secretos de almacenamiento\", () => { const text = pm.response.text(); pm.expect(text).not.to.include(\"hashContrasena\"); pm.expect(text).not.to.include(\"hash_contrasena\"); });",
              "pm.test(\"Baja conservadora\", () => pm.expect(pm.response.json().estado).to.eql(\"baja\"));"
            ]
          }
        }
      ]
    }
  ]
}
